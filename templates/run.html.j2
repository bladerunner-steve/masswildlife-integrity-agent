<!doctype html>
<!-- Run integrity report. Generated by mwia.verify.report (AI-assisted, Claude). Self-contained: no external requests. -->
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Run integrity report</title>
<style>
  :root { --fg:#1b1b1b; --muted:#5a5a5a; --line:#d9d9d9; --bg:#fff; --soft:#f5f5f3; --status:{{ colour }}; }
  @media (prefers-color-scheme: dark) { :root { --fg:#ececec; --muted:#b0b0b0; --line:#3a3a3a; --bg:#161616; --soft:#202020; } }
  body { margin:0; font:16px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; color:var(--fg); background:var(--bg); }
  main { max-width:960px; margin:0 auto; padding:24px 16px 48px; }
  h1 { font-size:1.4rem; margin:0 0 4px; } h2 { font-size:1.1rem; margin:28px 0 8px; }
  .status { border-left:6px solid var(--status); background:var(--soft); padding:14px 16px; border-radius:4px; margin:16px 0; }
  .status strong { color:var(--status); font-size:1.15rem; letter-spacing:.02em; }
  .banner { background:#fff4d6; color:#5c3d00; border:1px solid #e6c36a; padding:10px 14px; border-radius:4px; margin:12px 0; }
  .muted { color:var(--muted); } .scope { font-size:.95rem; color:var(--muted); }
  table { border-collapse:collapse; width:100%; font-size:.95rem; } th, td { border-bottom:1px solid var(--line); padding:6px 8px; text-align:left; }
  td.mark { text-align:center; font-weight:bold; } .pass { color:#1e7b34; } .fail { color:#b3261e; } .insufficient { color:#b26a00; } .na { color:var(--muted); font-weight:normal; }
  .first { border:1px solid var(--status); padding:10px 14px; border-radius:4px; }
  ul.findings li { margin:4px 0; } code { font-size:.88em; word-break:break-all; }
  dl { display:grid; grid-template-columns:max-content 1fr; gap:4px 16px; margin:0; } dt { color:var(--muted); }
  .wrap { overflow-x:auto; }
</style>
</head>
<body><main>
  <h1>Run integrity report</h1>
  <div class="muted">Run <code>{{ v.run_id }}</code></div>
  <div style="margin-top:12px">{{ badge | safe }}</div>

  {% if v.token_needs_refresh %}
  <div class="banner"><strong>Token needs refresh.</strong> The iNaturalist token was missing, expired or about to expire,
  so this run read public data anonymously. Paste a new token from https://www.inaturalist.org/users/api_token into <code>.env</code>.</div>
  {% endif %}

  <div class="status">
    <strong>{{ v.status }}</strong>
    <div>{{ explanation }}</div>
  </div>
  <p class="scope">{{ scope }}</p>
  <p class="muted">Checked by verifier configuration <strong>{{ v.config }}</strong> ({{ v.mode }}): layers
    {% for L in layers %}{{ L }} {{ layer_names[L] }}{% if not loop.last %}, {% endif %}{% endfor %}.</p>

  {% if v.first_failure %}
  <h2>Where it went wrong</h2>
  <div class="first">
    <div><strong>{% if v.first_failure.step is defined %}Step {{ v.first_failure.step }}{% if v.first_failure.module %} ({{ v.first_failure.module }}){% endif %}{% else %}Whole run{% endif %}</strong>,
      {{ layer_names[v.first_failure.layer] }} check</div>
    <div>{{ v.first_failure.message }}</div>
    {% if v.first_failure.detail %}<div class="muted"><code>{{ v.first_failure.detail }}</code></div>{% endif %}
  </div>
  {% endif %}

  <h2>Run</h2>
  <dl>
    <dt>Time window</dt><dd>{% if v.window %}{{ v.window.start }} to {{ v.window.end }} ({{ v.window.source }}){% else %}unknown{% endif %}</dd>
    <dt>Environment</dt><dd>{% if v.env %}vault {{ v.env.vault }}, database {{ v.env.db }} ({{ v.env.db_table }}){% endif %}{% if v.dry_run %}, dry run (no database writes){% endif %}</dd>
    <dt>Run outcome (agent)</dt><dd>{{ v.run_status or "not recorded" }}</dd>
    {% if v.counts %}
    <dt>Records</dt><dd>{{ v.counts.fetched }} fetched (of {{ v.counts.total_results }} reported);
      {% if v.counts.accepted %}accepted {{ v.counts.accepted.new }} new, {{ v.counts.accepted.changed }} changed, {{ v.counts.accepted.unchanged }} unchanged;{% endif %}
      inserted {{ v.counts.inserted }}, updated {{ v.counts.updated }}, skipped {{ v.counts.skipped }}</dd>
    {% endif %}
    <dt>Sealed</dt><dd>{{ "yes" if v.sealed else "no" }}</dd>
    <dt>Verified at</dt><dd>{{ v.verified_at }} with trusted key(s) {{ v.trusted_key_ids | join(", ") }}</dd>
  </dl>
  {% if v.flags %}<p><strong>Flags raised by the agent:</strong></p><ul>{% for f in v.flags %}<li>{{ f }}</li>{% endfor %}</ul>{% endif %}

  <h2>Step by step</h2>
  <div class="wrap"><table>
    <thead><tr><th>Step</th><th>Module</th>{% for L in ["A","B","C"] %}<th>{{ L }}: {{ layer_names[L] }}</th>{% endfor %}</tr></thead>
    <tbody>
    {% for s in v.steps %}<tr><td>PR{{ s.step }}</td><td>{{ s.module }}</td>
      {% for L in ["A","B","C"] %}{% set m = s[L] %}<td class="mark {{ 'pass' if m=='pass' else ('fail' if m=='fail' else ('insufficient' if m=='insufficient' else 'na')) }}">
        {{ {"pass":"✓ pass","fail":"✗ fail","insufficient":"! insufficient","absent":"– no receipt","not_checked":"not checked"}[m] }}</td>{% endfor %}
    </tr>{% endfor %}
    </tbody>
  </table></div>

  <h2>Findings</h2>
  {% set total = namespace(n=0) %}
  {% for L in layers %}{% set fs = v.findings[L] %}{% set total.n = total.n + fs|length %}
    {% if fs %}<p><strong>{{ L }}: {{ layer_names[L] }}</strong></p><ul class="findings">
    {% for f in fs %}<li class="{{ f.severity }}"><strong>{{ "✗" if f.severity == "fail" else "!" }}</strong>
      {% if f.step is defined %}PR{{ f.step }}: {% endif %}{{ f.message }}{% if f.detail %} <span class="muted"><code>{{ f.detail }}</code></span>{% endif %}</li>{% endfor %}
    </ul>{% endif %}
  {% endfor %}
  {% if total.n == 0 %}<p>No problems found by the enabled layers.</p>{% endif %}
</main></body>
</html>
