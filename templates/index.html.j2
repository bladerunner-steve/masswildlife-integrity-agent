<!doctype html>
<!-- All verified runs, newest first. Generated by mwia.verify.report (AI-assisted, Claude). No external requests. -->
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Integrity runs</title>
<style>
  :root { --fg:#1b1b1b; --muted:#5a5a5a; --line:#d9d9d9; --bg:#fff; }
  @media (prefers-color-scheme: dark) { :root { --fg:#ececec; --muted:#b0b0b0; --line:#3a3a3a; --bg:#161616; } }
  body { margin:0; font:16px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; color:var(--fg); background:var(--bg); }
  main { max-width:1100px; margin:0 auto; padding:24px 16px 48px; } h1 { font-size:1.4rem; }
  table { border-collapse:collapse; width:100%; font-size:.95rem; } th, td { border-bottom:1px solid var(--line); padding:6px 8px; text-align:left; vertical-align:middle; }
  a { color:inherit; } .muted { color:var(--muted); } code { font-size:.88em; } .wrap { overflow-x:auto; }
</style>
</head>
<body><main>
  <h1>Integrity runs</h1>
  <p class="muted">Every verified run, newest first. A badge attests the run's integrity within its stated scope, not that the
    observations themselves are correct.</p>
  <div class="wrap"><table>
    <thead><tr><th>Window end</th><th>Run</th><th>Environment</th><th>Integrity</th><th>Config</th><th>Records</th></tr></thead>
    <tbody>
    {% for r in rows %}{% set v = r.v %}<tr>
      <td>{{ v.window.end if v.window else "?" }}</td>
      <td><a href="{{ r.href }}"><code>{{ v.run_id[:8] }}</code></a></td>
      <td>{% if v.env %}{{ v.env.vault }} / {{ v.env.db }}{% endif %}{% if v.dry_run %} (dry run){% endif %}</td>
      <td>{{ r.badge | safe }}</td>
      <td>{{ v.config }}</td>
      <td>{% if v.counts %}{{ v.counts.fetched }} fetched, {{ v.counts.inserted }} inserted, {{ v.counts.updated }} updated{% endif %}</td>
    </tr>{% else %}<tr><td colspan="6">No verified runs yet.</td></tr>{% endfor %}
    </tbody>
  </table></div>
</main></body>
</html>
