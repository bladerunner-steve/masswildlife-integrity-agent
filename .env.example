# Copy to .env (same folder) and fill in real values. .env is gitignored.
# Placeholders only. Never commit real values.

# Optional. Paste from https://www.inaturalist.org/users/api_token (expires ~24h).
# Leave empty to run anonymously (allowed when policy auth.allow_anonymous: true).
INAT_API_TOKEN=

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=claude
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=masswildlife

# Encrypts the notary's private key (PKCS#8). Use a long random passphrase.
NOTARY_KEY_PASSPHRASE=change_me
